# Contact form (optional).
# Without these the form stays visible but reports that it is not configured
# and points visitors at the direct email address instead.
#
# RESEND_API_KEY    API key from https://resend.com
# CONTACT_FROM_EMAIL  A sender on a domain verified in your Resend account
# CONTACT_TO_EMAIL    Where enquiries are delivered (defaults to the address
#                     in src/content/profile.ts)

RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
